# ── Checkout API (Vercel serverless functions in /api) ──────────────────────
# Regional Stripe accounts (UK settles GBP + USD, IRL settles EUR).
# Use sk_test_... keys until go-live.
STRIPE_SECRET_KEY_GBP=
STRIPE_SECRET_KEY_EUR=
# Webhook signing secrets — one per account's endpoint (Stripe dashboard →
# Developers → Webhooks → endpoint pointing at /api/stripe-webhook).
STRIPE_WEBHOOK_SECRET_GBP=
STRIPE_WEBHOOK_SECRET_EUR=

# Platform database (order writes). Service-role key: server-side ONLY.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Canonical site origin for Stripe success/cancel redirects.
SITE_URL=https://hugodiamond.github.io/equireel-demo
# Comma-separated origins allowed to call the API (CORS).
ALLOWED_ORIGINS=https://hugodiamond.github.io

# Emails (Resend). Missing key = emails skipped, orders still recorded.
RESEND_API_KEY=
ORDERS_EMAIL_FROM=Equireel <info@equireel.com>
FULFILMENT_EMAIL=info@equireel.com

# ── Front end (build-time) ──────────────────────────────────────────────────
# Base URL of the checkout API. Same-origin Vercel deploy: /api
# Unset = the site runs in demo mode (simulated checkout).
NEXT_PUBLIC_CHECKOUT_API=

# ── Catalogue generator (scripts/gen_catalog.py) ────────────────────────────
# Read-only Postgres connection; falls back to the local platform clone's .env.
DATABASE_URL=
